{
  "openapi": "3.1.0",
  "info": {
    "title": "Analytic Madhyasth Darshan public study catalog",
    "version": "1.4.0",
    "description": "Read-only catalog of topical, formal, and applied studies. Markdown is the source of truth; HTML and PDF are generated. Write APIs (submissions, discussions) are separate and for humans; see /auth.md. JSON error responses use one envelope: success=false, code, message, requestId, and optional details. The same requestId is returned in the X-Request-ID response header."
  },
  "servers": [
    {
      "url": "https://analyticmadhyasthdarshan.org"
    }
  ],
  "tags": [
    {
      "name": "catalog"
    },
    {
      "name": "search"
    },
    {
      "name": "discovery"
    },
    {
      "name": "cite"
    }
  ],
  "paths": {
    "/Studies/catalog-all.json": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Unified catalog",
        "operationId": "getCatalogAll",
        "description": "All topical, formal, and applied rows in one array. Each row includes a collection field.",
        "responses": {
          "200": {
            "description": "Catalog rows.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CatalogRow"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/Studies/catalog-topical.json": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Topical catalog",
        "operationId": "getCatalogTopical",
        "responses": {
          "200": {
            "description": "Topical catalog rows.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CatalogRow"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/Studies/catalog-formal.json": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Formal catalog",
        "operationId": "getCatalogFormal",
        "responses": {
          "200": {
            "description": "Formal catalog rows.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CatalogRow"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/Studies/catalog-applied.json": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Applied catalog",
        "operationId": "getCatalogApplied",
        "responses": {
          "200": {
            "description": "Applied catalog rows.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CatalogRow"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/Studies/feed.json": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Change feed",
        "operationId": "getStudiesFeed",
        "description": "JSON Feed 1.1 of draft and released studies, newest Edited-on first. Ongoing rows are omitted.",
        "responses": {
          "200": {
            "description": "JSON Feed.",
            "content": {
              "application/feed+json": {
                "schema": {
                  "type": "object"
                }
              },
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/Studies/glossary.json": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Shared glossary",
        "operationId": "getGlossary",
        "responses": {
          "200": {
            "description": "Glossary terms used across studies.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Glossary"
                }
              }
            }
          }
        }
      }
    },
    "/api/studies": {
      "get": {
        "tags": [
          "search"
        ],
        "summary": "Search catalog rows",
        "operationId": "searchStudies",
        "description": "Same matching as WebMCP search_studies: substring match on title, slug, description, and category.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Search text. Alias: query."
          },
          {
            "name": "collection",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "topical",
                "formal",
                "applied"
              ]
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "ongoing",
                "draft",
                "released"
              ]
            }
          },
          {
            "name": "slug",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Exact catalog directory name."
          }
        ],
        "responses": {
          "200": {
            "description": "Matching studies with absolute HTML, PDF, and Markdown URLs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/UpstreamError"
          }
        }
      }
    },
    "/api/studies/{slug}": {
      "get": {
        "tags": [
          "search"
        ],
        "summary": "One study with heading outline",
        "operationId": "getStudyBySlug",
        "description": "Catalog row plus ## and ### headings from the canonical markdown. Markdown itself is not inlined; use mdUrl or MCP resource studies://study/{slug}.",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Catalog directory name, for example The-Ontology-of-Coexistence."
          }
        ],
        "responses": {
          "200": {
            "description": "Study metadata and heading outline.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudyDetail"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "502": {
            "$ref": "#/components/responses/UpstreamError"
          }
        }
      }
    },
    "/api/glossary": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Search glossary terms",
        "operationId": "searchGlossary",
        "description": "Substring match on id, display form, match aliases, and definition. Omit q to return every term.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Search text. Alias: query."
          }
        ],
        "responses": {
          "200": {
            "description": "Matching glossary terms.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GlossarySearchResponse"
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/UpstreamError"
          }
        }
      }
    },
    "/api/start-here": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "Recommended reading path",
        "operationId": "getStartHere",
        "description": "Ordered Start here stages with core and related slugs, one-line reasons, and catalog URLs. Aligns with the studies landing page.",
        "responses": {
          "200": {
            "description": "Reading path.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartHere"
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/UpstreamError"
          }
        }
      }
    },
    "/api/cite/{slug}": {
      "get": {
        "tags": [
          "cite"
        ],
        "summary": "Suggested citation for one study",
        "operationId": "getStudyCitation",
        "description": "Title, slug, status, Edited-on, published document URL, and a suggested citation line. Ongoing rows without a document are not citable. Do not invent timestamps.",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Citation payload.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CiteResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "502": {
            "$ref": "#/components/responses/UpstreamError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": [
          "success",
          "code",
          "message",
          "requestId"
        ],
        "additionalProperties": false,
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "requestId": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "CatalogRow": {
        "type": "object",
        "required": [
          "slug",
          "title",
          "status"
        ],
        "properties": {
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ongoing",
              "draft",
              "released"
            ]
          },
          "updated": {
            "type": "string"
          },
          "collection": {
            "type": "string",
            "enum": [
              "topical",
              "formal",
              "applied"
            ],
            "description": "Present on catalog-all.json rows."
          },
          "html": {
            "type": "string",
            "description": "Relative to /Studies/. Omitted for ongoing rows."
          },
          "pdf": {
            "type": "string"
          },
          "md": {
            "type": "string",
            "description": "Canonical markdown source. Omitted for ongoing rows."
          },
          "discussion": {
            "type": "string"
          }
        }
      },
      "SearchStudy": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "collection": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "updated": {
            "type": [
              "string",
              "null"
            ]
          },
          "htmlUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "pdfUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "mdUrl": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "SearchResponse": {
        "type": "object",
        "required": [
          "count",
          "studies"
        ],
        "properties": {
          "query": {
            "type": "string"
          },
          "collection": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "slug": {
            "type": [
              "string",
              "null"
            ]
          },
          "count": {
            "type": "integer"
          },
          "studies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchStudy"
            }
          }
        }
      },
      "Glossary": {
        "type": "object",
        "properties": {
          "terms": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "match": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "display": {
                  "type": "string"
                },
                "definition": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "Heading": {
        "type": "object",
        "properties": {
          "level": {
            "type": "integer",
            "enum": [
              2,
              3
            ]
          },
          "heading": {
            "type": "string"
          }
        }
      },
      "StudyDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SearchStudy"
          },
          {
            "type": "object",
            "properties": {
              "outline": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Heading"
                }
              }
            }
          }
        ]
      },
      "GlossarySearchResponse": {
        "type": "object",
        "required": [
          "count",
          "terms"
        ],
        "properties": {
          "query": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "terms": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "match": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "display": {
                  "type": "string"
                },
                "definition": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "StartHere": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "intro": {
            "type": "string"
          },
          "stages": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "parallelTrack": {
            "type": "object"
          }
        }
      },
      "CiteResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SearchStudy"
          },
          {
            "type": "object",
            "properties": {
              "author": {
                "type": "string"
              },
              "editedOn": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "url": {
                "type": "string"
              },
              "citation": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "headers": {
      "RequestId": {
        "description": "Correlation identifier for this failed request.",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 8,
          "maxLength": 128
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "The request is invalid.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "code": "invalid_request",
              "message": "The request is invalid.",
              "requestId": "01JABCDEFGHJKMNPQRSTVWXYZ12"
            }
          }
        }
      },
      "AuthenticationRequired": {
        "description": "Authentication is required.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "code": "authentication_required",
              "message": "Authentication is required.",
              "requestId": "01JABCDEFGHJKMNPQRSTVWXYZ12"
            }
          }
        }
      },
      "Forbidden": {
        "description": "The request is forbidden.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "code": "forbidden",
              "message": "The request is forbidden.",
              "requestId": "01JABCDEFGHJKMNPQRSTVWXYZ12"
            }
          }
        }
      },
      "NotFound": {
        "description": "The requested resource was not found.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "code": "not_found",
              "message": "The requested resource was not found.",
              "requestId": "01JABCDEFGHJKMNPQRSTVWXYZ12"
            }
          }
        }
      },
      "MethodNotAllowed": {
        "description": "The HTTP method is not allowed.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "code": "method_not_allowed",
              "message": "The HTTP method is not allowed.",
              "requestId": "01JABCDEFGHJKMNPQRSTVWXYZ12"
            }
          }
        }
      },
      "Conflict": {
        "description": "The request conflicts with current state.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "code": "conflict",
              "message": "The request conflicts with current state.",
              "requestId": "01JABCDEFGHJKMNPQRSTVWXYZ12"
            }
          }
        }
      },
      "PayloadTooLarge": {
        "description": "The request payload is too large.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "code": "payload_too_large",
              "message": "The request payload is too large.",
              "requestId": "01JABCDEFGHJKMNPQRSTVWXYZ12"
            }
          }
        }
      },
      "UnsupportedMediaType": {
        "description": "Content-Type must be application/json.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "code": "unsupported_media_type",
              "message": "Content-Type must be application/json.",
              "requestId": "01JABCDEFGHJKMNPQRSTVWXYZ12"
            }
          }
        }
      },
      "RateLimited": {
        "description": "The request rate limit was exceeded.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "code": "rate_limited",
              "message": "The request rate limit was exceeded.",
              "requestId": "01JABCDEFGHJKMNPQRSTVWXYZ12"
            }
          }
        }
      },
      "InternalError": {
        "description": "The request failed unexpectedly.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "code": "internal_error",
              "message": "The request failed unexpectedly.",
              "requestId": "01JABCDEFGHJKMNPQRSTVWXYZ12"
            }
          }
        }
      },
      "UpstreamError": {
        "description": "An upstream service failed.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "code": "upstream_error",
              "message": "An upstream service failed.",
              "requestId": "01JABCDEFGHJKMNPQRSTVWXYZ12"
            }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "A required service is unavailable.",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "code": "service_unavailable",
              "message": "A required service is unavailable.",
              "requestId": "01JABCDEFGHJKMNPQRSTVWXYZ12"
            }
          }
        }
      }
    }
  }
}
