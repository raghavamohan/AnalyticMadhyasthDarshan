.env
.env.local
.env.*.local
.dev.vars
.claude/settings.local.json

# Office lock / temp files
~$*

node_modules/
__pycache__/
Scripts/_pdf_cache/
Scripts/_reference_cache/
/tmp/reference-*/
/tmp/fresh-reference-cache/
/tmp/rights-text/
/tmp/pdfs/
.tmp.driveupload/
.tmp.drivedownload/
*.html
!Studies/search.html
!Studies/notebook.html
!Scripts/_test_study_notes_browser.html
!References/**/*.html
!Studies/index.html
!Studies/submit.html
!Studies/*/*.html
!Applications/*/*.html
!/index.html
!/api-docs.html
!google*.html

# Generated reader artifacts are verified locally/CI and published to Cloudflare
# R2. Reference PDFs follow References/r2-artifacts.json: approved payloads are
# hydrated into the ignored cache; rights-review and active-translation sources
# remain tracked.
/Studies/*/*.pdf
/Applications/*/*.pdf

infra/worker/.wrangler/
infra/worker/.turnstile-secret.tmp
infra/discussions-worker/.wrangler/
infra/google-verification-worker/.wrangler/
infra/api-catalog-worker/.wrangler/
infra/agent-card-worker/.wrangler/
infra/agent-card-worker/src/index.js
infra/agent-skills-worker/.wrangler/
infra/agent-skills-worker/src/index.js
infra/mcp-worker/.wrangler/
infra/mcp-worker/src/index.js
infra/web-bot-auth-worker/.wrangler/
infra/web-bot-auth-worker/src/index.js
infra/auth-md-worker/.wrangler/
infra/auth-md-worker/src/index.js

# Cygwin/Git-Bash crash dumps
*.stackdump
